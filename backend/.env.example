# ==============================================================================
# DISCORD VERIFICATION BACKEND (RENDER FREE SERVICE)
# ==============================================================================

NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:4000

# Discord Application Credentials
DISCORD_BOT_TOKEN=your_discord_bot_token
DISCORD_CLIENT_ID=your_discord_client_id
DISCORD_CLIENT_SECRET=your_discord_client_secret
DISCORD_REDIRECT_URI=http://localhost:3000/auth/callback
DISCORD_ADMIN_REDIRECT_URI=http://localhost:3000/admin/auth/callback
DEV_GUILD_ID=

# Supabase Credentials (PostgreSQL DB with RLS)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Secrets
JWT_SECRET=super_secret_jwt_auth_key_at_least_32_characters
TOKEN_SIGNING_SECRET=super_secret_token_signing_key_at_least_32_characters

# Admin Bootstrap & Passkey
INITIAL_ADMIN_DISCORD_ID=your_discord_snowflake_id
ADMIN_SECRET=emergency_admin_passkey_for_dev_or_console
