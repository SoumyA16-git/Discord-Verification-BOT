<%- include('partials/header') %>

<div class="center-container">
  <div class="card">
    <div class="status-icon-wrapper status-failure">
      <svg viewBox="0 0 24 24" fill="currentColor">
        <path d="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"/>
      </svg>
    </div>

    <h1>Verification Failed</h1>
    <p>
      <%= reason %>
    </p>

    <div class="alert alert-danger" style="text-align: left;">
      <strong>What to do next:</strong>
      <ul style="margin-left: 1.25rem; margin-top: 0.5rem; font-size: 0.85rem;">
        <li>Ensure you authorized the exact same Discord account you are logged into.</li>
        <li>Open your Discord server and type <code>/verify</code> to generate a fresh link.</li>
        <li>If the issue persists, please notify a server moderator or administrator.</li>
      </ul>
    </div>

    <a href="https://discord.com/channels/@me" class="btn btn-secondary btn-block">
      Back to Discord
    </a>
  </div>
</div>

<%- include('partials/footer') %>
