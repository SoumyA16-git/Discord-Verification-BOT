<%- include('../partials/header') %>

<div style="margin-bottom: 2rem; display: flex; justify-content: space-between; align-items: flex-end; flex-wrap: wrap; gap: 1rem;">
  <div>
    <h1>Server Configuration</h1>
    <p style="margin-bottom: 0;">Configure roles, channel bindings, timeouts, and rate limits for this Discord server.</p>
  </div>
  <button type="button" id="test-config-btn" class="btn btn-secondary">
    Run Permission Diagnostics
  </button>
</div>

<div id="test-config-output" style="display: none; margin-bottom: 1.5rem;"></div>

<% if (typeof message !== 'undefined' && message) { %>
  <div class="alert alert-success"><%= message %></div>
<% } %>

<div class="card card-wide">
  <form action="/admin/config" method="POST">
    <div class="form-group" style="display: flex; align-items: center; gap: 0.75rem; background: var(--bg-tertiary); padding: 1rem; border-radius: var(--radius-sm);">
      <input type="checkbox" id="verification_enabled" name="verification_enabled" value="true" <%= config.verification_enabled ? 'checked' : '' %> style="width: 20px; height: 20px; accent-color: var(--discord-blurple);">
      <div>
        <label for="verification_enabled" style="font-weight: 700; cursor: pointer; color: var(--text-primary);">Enable Verification Gate</label>
        <div class="form-help">Master switch. When enabled, new members will be prompted to verify via OAuth2.</div>
      </div>
    </div>

    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1.5rem;">
      <div class="form-group">
        <label class="form-label" for="verified_role_id">Verified Role ID (Snowflake)</label>
        <input type="text" id="verified_role_id" name="verified_role_id" value="<%= config.verified_role_id || '' %>" class="form-input" placeholder="e.g. 123456789012345678">
        <div class="form-help">Role assigned to members upon successful verification.</div>
      </div>

      <div class="form-group">
        <label class="form-label" for="unverified_role_id">Unverified Role ID (Optional)</label>
        <input type="text" id="unverified_role_id" name="unverified_role_id" value="<%= config.unverified_role_id || '' %>" class="form-input" placeholder="e.g. 234567890123456789">
        <div class="form-help">Optional role stripped from members when they verify.</div>
      </div>

      <div class="form-group">
        <label class="form-label" for="verification_channel_id">Verification Channel ID</label>
        <input type="text" id="verification_channel_id" name="verification_channel_id" value="<%= config.verification_channel_id || '' %>" class="form-input" placeholder="e.g. 345678901234567890">
        <div class="form-help">Public channel where fallback verification button is posted.</div>
      </div>

      <div class="form-group">
        <label class="form-label" for="log_channel_id">Audit Log Channel ID (Optional)</label>
        <input type="text" id="log_channel_id" name="log_channel_id" value="<%= config.log_channel_id || '' %>" class="form-input" placeholder="e.g. 456789012345678901">
        <div class="form-help">Discord channel where verification events/warnings are posted.</div>
      </div>
    </div>

    <div class="form-group">
      <label class="form-label" for="verification_message">Custom Verification Prompt Message</label>
      <textarea id="verification_message" name="verification_message" class="form-textarea" rows="3" placeholder="Click the button below to verify your account."><%= config.verification_message || '' %></textarea>
    </div>

    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1.5rem;">
      <div class="form-group">
        <label class="form-label" for="session_expiration_minutes">Session Expiration (Minutes)</label>
        <input type="number" id="session_expiration_minutes" name="session_expiration_minutes" value="<%= config.session_expiration_minutes || 15 %>" class="form-input" min="1" max="1440">
      </div>

      <div class="form-group">
        <label class="form-label" for="rate_limit_attempts">Max Attempts per Window</label>
        <input type="number" id="rate_limit_attempts" name="rate_limit_attempts" value="<%= config.rate_limit_attempts || 5 %>" class="form-input" min="1" max="50">
      </div>

      <div class="form-group">
        <label class="form-label" for="rate_limit_window_minutes">Rate Limit Window (Minutes)</label>
        <input type="number" id="rate_limit_window_minutes" name="rate_limit_window_minutes" value="<%= config.rate_limit_window_minutes || 10 %>" class="form-input" min="1" max="1440">
      </div>
    </div>

    <div style="margin-top: 1.5rem; text-align: right;">
      <button type="submit" class="btn btn-primary">Save Configuration</button>
    </div>
  </form>
</div>

<%- include('../partials/footer') %>
