<%- include('../partials/header') %>

<div class="center-container">
  <div class="card">
    <div class="status-icon-wrapper status-already">
      <svg viewBox="0 0 24 24" fill="currentColor">
        <path d="M18 8h-1V6c0-2.76-2.24-5-5-5S7 3.24 7 6v2H6c-1.1 0-2 .9-2 2v10c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V10c0-1.1-.9-2-2-2zm-6 9c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2zm3.1-9H8.9V6c0-1.71 1.39-3.1 3.1-3.1 1.71 0 3.1 1.39 3.1 3.1v2z"/>
      </svg>
    </div>

    <h1>Admin Dashboard Login</h1>
    <p>Authenticate with an authorized Discord account or enter the emergency administrative passkey.</p>

    <% if (typeof error !== 'undefined' && error) { %>
      <div class="alert alert-danger" style="margin-bottom: 1.5rem;">
        <%= error %>
      </div>
    <% } %>

    <div style="margin-bottom: 2rem;">
      <a href="<%= oauthUrl %>" class="btn btn-primary btn-block" style="padding: 0.9rem;">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M20.317 4.37a19.791 19.791 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07..07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 0 0 .031.057 19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028c.462-.63.874-1.295 1.226-1.994.021-.041.001-.09-.041-.106a13.107 13.107 0 0 1-1.872-.892.077.077 0 0 1-.008-.128 10.2 10.2 0 0 0 .372-.292.074.074 0 0 1 .077-.01c3.929 1.793 8.18 1.793 12.061 0a.074.074 0 0 1 .078.01c.12.098.246.198.373.292a.077.077 0 0 1-.006.127 12.299 12.299 0 0 1-1.873.893.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.839 19.839 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.028z"/></svg>
        Login with Discord OAuth2
      </a>
    </div>

    <% if (hasAdminSecret) { %>
      <div style="position: relative; margin: 1.5rem 0; border-top: 1px solid var(--border-color);">
        <span style="position: absolute; top: -10px; left: 50%; transform: translateX(-50%); background: var(--bg-card); padding: 0 0.75rem; font-size: 0.75rem; color: var(--text-muted); text-transform: uppercase;">
          Or Emergency Passkey
        </span>
      </div>

      <form action="/admin/login" method="POST" style="margin-top: 1.5rem;">
        <div class="form-group">
          <label class="form-label" for="secret">Admin Secret</label>
          <input type="password" id="secret" name="secret" class="form-input" placeholder="Enter ADMIN_SECRET" required>
        </div>
        <button type="submit" class="btn btn-secondary btn-block">Sign In with Secret</button>
      </form>
    <% } %>
  </div>
</div>

<%- include('../partials/footer') %>
