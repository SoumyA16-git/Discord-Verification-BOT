<%- include('partials/header') %>

<div class="center-container">
  <div class="card" style="max-width: 640px; padding: 3.5rem 2.5rem;">
    <div class="status-icon-wrapper status-already" style="margin-bottom: 2rem;">
      <svg viewBox="0 0 24 24" fill="currentColor">
        <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/>
      </svg>
    </div>

    <h1>Discord Member Verification</h1>
    <p style="font-size: 1.05rem; margin-bottom: 2rem;">
      A high-performance, tamper-proof Discord verification gate powered by OAuth2. Protect your community with seamless role assignment, robust CSRF protection, and comprehensive audit logs.
    </p>

    <div style="display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap;">
      <a href="<%= botInviteUrl %>" target="_blank" class="btn btn-primary" style="padding: 0.9rem 2rem;">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M20.317 4.37a19.791 19.791 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07..07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 0 0 .031.057 19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028c.462-.63.874-1.295 1.226-1.994.021-.041.001-.09-.041-.106a13.107 13.107 0 0 1-1.872-.892.077.077 0 0 1-.008-.128 10.2 10.2 0 0 0 .372-.292.074.074 0 0 1 .077-.01c3.929 1.793 8.18 1.793 12.061 0a.074.074 0 0 1 .078.01c.12.098.246.198.373.292a.077.077 0 0 1-.006.127 12.299 12.299 0 0 1-1.873.893.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.839 19.839 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.028z"/></svg>
        Add Bot to Server
      </a>
      <a href="/admin/login" class="btn btn-secondary" style="padding: 0.9rem 1.8rem;">
        Admin Dashboard
      </a>
    </div>

    <div style="margin-top: 3rem; padding-top: 2rem; border-top: 1px solid var(--border-color); display: flex; justify-content: space-around; text-align: center;">
      <div>
        <div style="font-weight: 700; font-size: 1.2rem; color: var(--discord-green);">OAuth2</div>
        <div class="text-sm" style="color: var(--text-muted);">Real Identity Proof</div>
      </div>
      <div>
        <div style="font-weight: 700; font-size: 1.2rem; color: var(--discord-blurple);">Auto Roles</div>
        <div class="text-sm" style="color: var(--text-muted);">Instant Guild Sync</div>
      </div>
      <div>
        <div style="font-weight: 700; font-size: 1.2rem; color: var(--discord-yellow);">Zero Leak</div>
        <div class="text-sm" style="color: var(--text-muted);">No Tokens Stored</div>
      </div>
    </div>
  </div>
</div>

<%- include('partials/footer') %>
